---
import MainLayout from '../layouts/MainLayout.astro';
import { Picture } from 'astro:assets';
import img1 from '../assets/img/img1.webp';
import img2 from '../assets/img/img2.webp';
import img3 from '../assets/img/img3.webp';

const slides = [
  { src: img1, alt: 'Stonechats — a Cornish getaway' },
  { src: img2, alt: 'Inside Stonechats' },
  { src: img3, alt: 'The Cornish coastline near Stonechats' },
];

const heroWidths = [600, 900, 1200, 1800, 2400];
---

<MainLayout title="Stonechats — A Cornish getaway">
  <section class="hero-carousel-section">
    <div
      id="stonechatsHero"
      class="carousel slide hero-carousel"
      data-bs-ride="carousel"
      data-bs-interval="6000"
    >
      <div class="carousel-inner">
        {
          slides.map((slide, i) => (
            <div class={`carousel-item ${i === 0 ? 'active' : ''}`}>
              <Picture
                src={slide.src}
                widths={heroWidths}
                sizes="100vw"
                formats={['avif', 'webp']}
                alt={slide.alt}
                class="hero-image"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
          ))
        }
      </div>
      <div class="hero-caption">
        <p class="hero-line">Stylish and comfortable holiday home</p>
        <p class="hero-line">Ideal for families</p>
        <p class="hero-line">Close to beautiful beaches</p>
      </div>
      <button
        class="carousel-control-prev"
        type="button"
        data-bs-target="#stonechatsHero"
        data-bs-slide="prev"
      >
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button
        class="carousel-control-next"
        type="button"
        data-bs-target="#stonechatsHero"
        data-bs-slide="next"
      >
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </section>

  <section class="section section-alice">
    <div class="container">
      <div class="content-narrow text-center reveal">
        <h1>Welcome to our Cornish getaway</h1>
        <p style="margin-top: 1.25rem;">
          Stonechats is a beautifully styled holiday home, just minutes from Cornwall's finest
          beaches. Whether you're here for adventure or rest, you'll find everything you need.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="container">
      <div class="content-narrow text-center reveal">
        <p style="font-size: 1.15rem; margin-bottom: 2rem;">
          Everything you need to know about your stay.
        </p>
        <a class="btn-stonechats" href="/welcome-pack">View the Welcome Pack</a>
      </div>
    </div>
  </section>

  <section class="section section-alice">
    <div class="container">
      <div class="content-narrow text-center reveal">
        <h2>Get in Touch</h2>
        <p style="margin-top: 1.25rem; font-size: 1.15rem;">
          <i
            class="bi bi-envelope"
            aria-hidden="true"
            style="margin-right: 0.5rem; color: var(--color-tiger-flame);"></i>
          <a href="mailto:linda@prosserfamily.net">linda@prosserfamily.net</a>
        </p>
      </div>
    </div>
  </section>
</MainLayout>
