---
const year = new Date().getFullYear();
---

<footer class="stonechats-footer">
  <div class="container">
    <div class="row">
      <div class="col-md-4 footer-col">
        <h3 class="footer-brand">
          Stonechats <span class="footer-brand-sub">Newquay, Cornwall</span>
        </h3>
        <p class="footer-contact">
          <i class="bi bi-envelope" aria-hidden="true"></i>
          <a href="mailto:info@stonechats.com">info@stonechats.com</a>
        </p>
        <!-- <p class="footer-contact">
          <i class="bi bi-telephone" aria-hidden="true"></i>
          xxxx xxx xxx
        </p> -->
        <hr class="footer-hr" />
        <p class="footer-copyright">&copy; {year} Stonechats</p>
        <hr class="footer-hr d-md-none" />
      </div>

      <div class="col-md-4 footer-col">
        <h4 class="footer-heading">Site</h4>
        <ul class="footer-list">
          <li><a href="/">Home</a></li>
          <li><a href="/welcome-pack">Welcome Pack</a></li>
        </ul>

        <h4 class="footer-heading">Legal</h4>
        <ul class="footer-list">
          <li><a href="/legals/terms-and-conditions">Terms and conditions</a></li>
        </ul>
        <hr class="footer-hr d-md-none" />
      </div>

      <div class="col-md-4 footer-col">
        <h4 class="footer-heading">Follow</h4>
        <p class="footer-contact">
          <i class="bi bi-instagram" aria-hidden="true"></i>
          <a
            href="https://www.instagram.com/stonechatscornwall/"
            target="_blank"
            rel="noopener noreferrer">@stonechatscornwall</a
          >
        </p>
        <hr class="footer-hr d-md-none" />
      </div>
    </div>

    <div class="footer-bottom">
      <a href="https://proactiveweb.design" target="_blank" rel="noopener noreferrer"
        >Website by Proactive Web Design</a
      >
    </div>
  </div>
</footer>
