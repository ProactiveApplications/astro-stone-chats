---
import NavLayout from './NavLayout.astro';
import FooterLayout from './FooterLayout.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <style is:global>
      :root {
        --color-alice-blue: #ebf2f4;
        --color-yale-blue: #1b4965;
        --color-cool-steel: #a6b9bf;
        --color-white: #ffffff;
        --color-night-bordeaux: #561d25;
        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-body: 'Work Sans', system-ui, -apple-system, sans-serif;
      }

      html { scroll-behavior: smooth; }

      body {
        font-family: var(--font-body);
        color: var(--color-yale-blue);
        background: var(--color-white);
        font-size: 1.0625rem;
        line-height: 1.7;
      }

      main { padding-top: 4.5rem; }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
        color: var(--color-yale-blue);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.005em;
      }
      h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 700; }
      h2 { font-size: clamp(1.75rem, 3.5vw, 2.25rem); margin-bottom: 1rem; }
      h3 { font-size: clamp(1.25rem, 2.5vw, 1.5rem); }

      p { margin-bottom: 1rem; }
      .lead { font-size: 1.15rem; color: var(--color-yale-blue); opacity: 0.85; }

      a {
        color: var(--color-yale-blue);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
        transition: color 0.2s ease;
      }
      a:hover, a:focus { color: var(--color-night-bordeaux); }

      .btn-stonechats {
        background: var(--color-yale-blue);
        color: var(--color-white);
        border: none;
        border-radius: 0.5rem;
        padding: 0.9rem 2rem;
        font-family: var(--font-body);
        font-weight: 500;
        font-size: 1.0625rem;
        letter-spacing: 0.02em;
        text-decoration: none;
        display: inline-block;
        transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
        box-shadow: 0 2px 6px rgba(27, 73, 101, 0.15);
      }
      .btn-stonechats:hover, .btn-stonechats:focus {
        background: var(--color-night-bordeaux);
        color: var(--color-white);
        transform: translateY(-2px);
        box-shadow: 0 6px 14px rgba(86, 29, 37, 0.25);
      }

      .section { padding-block: clamp(3.5rem, 8vw, 6rem); }
      .section-alice { background: var(--color-alice-blue); }
      .section-white { background: var(--color-white); }
      .content-narrow { max-width: 720px; margin-inline: auto; }

      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.9s ease, transform 0.9s ease;
        will-change: opacity, transform;
      }
      .reveal.is-visible { opacity: 1; transform: translateY(0); }

      .lift { transition: transform 0.25s ease, box-shadow 0.25s ease; }
      .lift:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(27, 73, 101, 0.12); }

      .stonechats-card {
        background: var(--color-white);
        border: 1px solid rgba(166, 185, 191, 0.4);
        border-radius: 0.75rem;
        padding: clamp(1.5rem, 3vw, 2.25rem);
        height: 100%;
      }
      .stonechats-card.alt { background: var(--color-alice-blue); }
      .card-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        background: var(--color-yale-blue);
        color: var(--color-white);
        font-size: 1.4rem;
        margin-bottom: 1rem;
      }
      .stonechats-card h2 { margin-top: 0; }
      .stonechats-card h3 { margin-top: 1.25rem; }

      .credentials {
        background: var(--color-yale-blue);
        color: var(--color-white);
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem 1.25rem;
        font-family: var(--font-body);
        font-size: 1.0625rem;
        align-items: baseline;
      }
      .credentials .cred-label { color: var(--color-cool-steel); font-weight: 500; }
      .credentials .cred-value {
        font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
        letter-spacing: 0.02em;
        word-break: break-all;
      }

      .rule-item {
        padding: 1.15rem 0;
        border-bottom: 1px solid rgba(166, 185, 191, 0.35);
      }
      .rule-item:last-child { border-bottom: 0; }
      .rule-item h3 {
        font-family: var(--font-body);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-night-bordeaux);
        margin: 0 0 0.35rem;
      }
      .rule-item p { margin: 0; }

      .address-block {
        color: var(--color-yale-blue);
        background: var(--color-alice-blue);
        border-left: 3px solid var(--color-yale-blue);
        padding: 1rem 1.25rem;
        border-radius: 0 0.5rem 0.5rem 0;
        display: inline-block;
        font-family: var(--font-body);
        line-height: 1.5;
      }
      .address-block .a-title { font-weight: 600; }

      .info-list { list-style: none; padding: 0; margin: 0; }
      .info-list li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid rgba(166, 185, 191, 0.35);
      }
      .info-list li:last-child { border-bottom: 0; }
      .info-list .info-main { flex: 1; }
      .info-list .info-name { font-weight: 500; color: var(--color-yale-blue); }
      .info-list .info-desc {
        display: block;
        color: var(--color-yale-blue);
        opacity: 0.8;
        font-size: 0.95rem;
        margin-top: 0.1rem;
      }
      .info-list .info-time {
        white-space: nowrap;
        color: var(--color-night-bordeaux);
        font-weight: 500;
        font-size: 0.95rem;
      }

      .hero-carousel-section { margin-top: -4.5rem; }
      .hero-carousel .carousel-item {
        min-height: 70vh;
        background-size: cover;
        background-position: center;
        position: relative;
      }
      .hero-carousel .carousel-item::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 1;
      }
      .hero-slide-1 { background-color: #1b4965; }
      .hero-slide-2 { background-color: #2d5f7c; }
      .hero-slide-3 { background-color: #17405a; }

      .hero-caption {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--color-white);
        padding: 5rem 1.25rem 3rem;
        z-index: 2;
      }
      .hero-caption .hero-line {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--color-white);
        font-size: clamp(1.6rem, 4vw, 2.75rem);
        line-height: 1.15;
        margin: 0.35rem 0;
        max-width: 22ch;
        opacity: 0;
        transform: translateY(24px);
      }
      .hero-caption.is-active .hero-line { animation: heroFadeUp 1s ease forwards; }
      .hero-caption.is-active .hero-line:nth-child(1) { animation-delay: 0.2s; }
      .hero-caption.is-active .hero-line:nth-child(2) { animation-delay: 0.7s; }
      .hero-caption.is-active .hero-line:nth-child(3) { animation-delay: 1.2s; }
      @keyframes heroFadeUp {
        to { opacity: 1; transform: translateY(0); }
      }
      .carousel-control-prev, .carousel-control-next { z-index: 3; opacity: 0.55; }
      .carousel-control-prev:hover, .carousel-control-next:hover { opacity: 0.9; }

      .stonechats-navbar { background: var(--color-yale-blue) !important; }
      .stonechats-navbar .navbar-brand {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.65rem;
        color: var(--color-white) !important;
        letter-spacing: 0.005em;
      }
      .stonechats-navbar .nav-link {
        color: var(--color-white) !important;
        font-family: var(--font-body);
        font-weight: 400;
        padding: 0.5rem 1rem !important;
        opacity: 0.85;
        transition: opacity 0.2s ease;
      }
      .stonechats-navbar .nav-link:hover { opacity: 1; }
      .stonechats-navbar .nav-link.active {
        opacity: 1;
        font-weight: 600;
        border-bottom: 2px solid var(--color-cool-steel);
      }
      .stonechats-navbar .navbar-toggler {
        border-color: rgba(255,255,255,0.3);
        padding: 0.35rem 0.6rem;
      }
      .stonechats-navbar .navbar-toggler:focus { box-shadow: none; }
      .stonechats-navbar .navbar-toggler-icon {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255,255,255,0.85%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
      }

      .stonechats-footer {
        background: var(--color-yale-blue);
        color: var(--color-white);
        padding: 2.75rem 0;
        text-align: center;
      }
      .stonechats-footer p { margin: 0; }
      .stonechats-footer .tagline {
        font-family: var(--font-display);
        font-style: italic;
        color: var(--color-cool-steel);
        margin-top: 0.35rem;
        font-size: 1.1rem;
      }

      .faq-topic { margin-bottom: 1.75rem; }
      .faq-topic:last-child { margin-bottom: 0; }
      .faq-topic h3 {
        font-family: var(--font-body);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-night-bordeaux);
        margin: 0 0 0.5rem;
      }
      .faq-topic ul { padding-left: 1.25rem; margin: 0; }
      .faq-topic li { margin-bottom: 0.35rem; }
      .faq-topic p { margin: 0 0 0.5rem; }

      .external-link::after {
        content: '\2197';
        display: inline-block;
        margin-left: 0.2em;
        font-size: 0.85em;
      }
    </style>
  </head>
  <body>
    <NavLayout />
    <main>
      <slot />
    </main>
    <FooterLayout />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script is:inline>
      (function () {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || els.length === 0) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      })();

      (function () {
        const carousel = document.querySelector('.hero-carousel');
        if (!carousel) return;
        const setActive = () => {
          carousel.querySelectorAll('.carousel-item').forEach((item) => {
            const cap = item.querySelector('.hero-caption');
            if (!cap) return;
            if (item.classList.contains('active')) cap.classList.add('is-active');
            else cap.classList.remove('is-active');
          });
        };
        setActive();
        carousel.addEventListener('slide.bs.carousel', () => {
          carousel.querySelectorAll('.hero-caption').forEach((c) => c.classList.remove('is-active'));
        });
        carousel.addEventListener('slid.bs.carousel', setActive);
      })();
    </script>
  </body>
</html>
